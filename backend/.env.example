# Modelo de configuração. Copie para `.env` e preencha os valores reais.
# O `.env` NÃO é versionado (contém senhas) — veja o .gitignore.

PORT=3001
JWT_SECRET=troque_por_um_segredo_forte_e_unico
JWT_EXPIRES_IN=8h
DB_PATH=./db/mutti.db
NODE_ENV=development

# ===== ERP (Postgres A7/Trier) — integração de vendas ao vivo =====
# Usuário SOMENTE LEITURA. O banco muda de nome (snapshot multimais_esc_AAAAMMDD);
# deixe ERP_DB em branco para auto-detectar o mais recente (multimais_esc_%).
ERP_HOST=
ERP_PORT=5432
ERP_USER=
ERP_PASSWORD=
ERP_DB=
ERP_DB_BOOTSTRAP=
ERP_ENABLED=true
# TTL do cache de vendas/indicadores (segundos). 0 = sem cache.
ERP_CACHE_TTL=120

# ===== Trivio (CRM PDV+) — indicador PDV+ = Taxa de Conversão por vendedor =====
TRIVIO_ENABLED=true
TRIVIO_API=https://api.triv.io
TRIVIO_DASH=https://dashboards.triv.io
TRIVIO_DASHBOARD_ID=3026
TRIVIO_EMAIL=
TRIVIO_SENHA=
# TTL do cache (segundos):
TRIVIO_CACHE_TTL=1800

# ===== Backup por e-mail (opcional) =====
BACKUP_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sistema Mutti <seu-email@gmail.com>

# API do e-commerce (Giro Premiado) — conversão × ERP
ECOMM_API_SECRET=
