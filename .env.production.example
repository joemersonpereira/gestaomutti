# Modelo do .env.production da VPS. NÃO versionar o arquivo real (tem senhas).
#
# Destino: /opt/apps/gestaomutti/.env.production  (chmod 600, dono: deploy)
# O stack.yml o carrega via env_file. Depois de editar, redeploye a stack
# (push em main, ou `docker stack deploy` à mão — ver docs/deploy-vps.md).
#
# Lista conferida contra `grep process.env` em backend/src em 2026-10-15.
# Variável vazia = integração desligada; nada aqui tem valor fixo no código.

# ===== Núcleo =====
NODE_ENV=production
PORT=3001
# Caminho DENTRO do container. /data é o volume `db` do stack.yml. Não mude.
DB_PATH=/data/mutti.db
# Gere com: openssl rand -hex 48   (o entrypoint recusa subir sem ele)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ===== ERP (Postgres A7/Trier) — vendas ao vivo =====
# Usuário SOMENTE LEITURA. O banco muda de nome (snapshot multimais_esc_AAAAMMDD);
# deixe ERP_DB em branco para auto-detectar o mais recente (multimais_esc_%).
# ⚠️ O firewall do ERP precisa liberar o IP da VPS (170.205.37.202).
ERP_HOST=
ERP_PORT=5432
ERP_USER=
ERP_PASSWORD=
ERP_DB=
ERP_DB_BOOTSTRAP=
ERP_ENABLED=true
# TTL do cache de vendas/indicadores (segundos). 0 = sem cache.
ERP_CACHE_TTL=120

# ===== Trivio (CRM PDV+) — Taxa de Conversão por vendedor =====
TRIVIO_ENABLED=true
TRIVIO_API=https://api.triv.io
TRIVIO_DASH=https://dashboards.triv.io
TRIVIO_DASHBOARD_ID=3026
TRIVIO_EMAIL=
TRIVIO_SENHA=
TRIVIO_CACHE_TTL=1800

# ===== E-mail → Tarefa (IMAP) =====
# Lê a caixa e transforma e-mails de remetentes cadastrados em tarefas.
EMAIL_ENABLED=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=imap.hostinger.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.hostinger.com
EMAIL_SMTP_PORT=465
EMAIL_PASTA=INBOX
# Janela de varredura, em dias.
EMAIL_DIAS=7

# ===== Backup por e-mail (opcional — backup.js) =====
# O backup local sempre acontece (volume `backups`); o e-mail é um extra.
BACKUP_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sistema Mutti <seu-email@dominio>

# ===== BotVendas (Iqnus) — atendimento WhatsApp / funil de pedidos =====
# Sem EMAIL+PASSWORD a integração fica desligada.
BOTVENDAS_HOST=
BOTVENDAS_EMAIL=
BOTVENDAS_PASSWORD=
# Setores de atendimento humano (ids separados por vírgula). Vazio = todos.
BOTVENDAS_SECTOR_IDS=

# ===== Tangerino/Sólides (ponto eletrônico) =====
# Valor do header "Authorization: Basic". Vazio = integração desligada.
TANGERINO_TOKEN=

# ===== Rhia (IA do sistema) =====
# Sem a chave, a Rhia devolve os trechos encontrados na base sem gerar resposta.
ANTHROPIC_API_KEY=
RHIA_MODELO=
# Binário do pdftotext (poppler) para ingerir PDFs. A imagem não traz poppler;
# deixe vazio até instalar na imagem.
PDFTOTEXT_PATH=
POPPLER_PDFTOTEXT=

# ===== Espião de NF-e (API v1) =====
ESPIAO_V1_API_BASE=
ESPIAO_V1_TOKEN_CONTA=
ESPIAO_V1_TOKEN_USUARIO=

# ===== API do e-commerce (Giro Premiado) — conversão × ERP =====
ECOMM_API_SECRET=

# ===== Ajustes finos =====
# Build do React. Vazio = ../../frontend/build, que é o correto na imagem.
FRONTEND_BUILD_DIR=
# Tolerância, em minutos, entre batidas no recebimento.
RECEB_GAP_BATIDA_MIN=5
# Planilhas de previsão (migrações 186/188 leem no primeiro boot). Caminhos de
# Windows não existem no container: deixe vazio, a migração avisa e segue.
PREVISAO_VENDAS_XLSX=
PREVISAO_DRE_XLSX=
